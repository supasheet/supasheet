<!--
  Sample HTML-based PDF report template for
  finance.receivables_aging_report.

  Upload this file as-is to the `report-templates` storage bucket under
  the `finance` folder, as a user in the "x-admin" role — the object key
  `finance/receivables_aging_report.hbs` IS the report identity, so the
  filename must exactly match the view name plus `.hbs`. This enables
  the "Print Report" button on the Receivables Aging page. The report
  page compiles this template with Handlebars against `{ name, rows }`,
  where `rows` is the currently loaded report data, and opens the result
  in a new tab for printing or saving as a PDF.
-->
<h1>{{name}}</h1>
<table border="1" cellspacing="0" cellpadding="4">
  <thead>
    <tr>
      <th>Invoice</th>
      <th>Customer</th>
      <th>Status</th>
      <th>Issued</th>
      <th>Due</th>
      <th>Bucket</th>
      <th>Days Late</th>
      <th>Total</th>
      <th>Paid</th>
      <th>Balance</th>
      <th>PO</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr>
        <td>{{invoice_number}}</td>
        <td>{{customer}} ({{customer_code}})</td>
        <td>{{status}}</td>
        <td>{{issue_date}}</td>
        <td>{{due_date}}</td>
        <td>{{bucket}}</td>
        <td>{{days_overdue}}</td>
        <td>{{total}} {{currency}}</td>
        <td>{{paid_total}}</td>
        <td>{{balance_due}}</td>
        <td>{{purchase_order}}</td>
      </tr>
    {{else}}
      <tr>
        <td colspan="11">No data</td>
      </tr>
    {{/each}}
  </tbody>
</table>