<!--
  Sample HTML-based PDF report template for procurement.purchase_orders_report.

  Upload this file as-is to the `report-templates` storage bucket
  under the `procurement` folder, as a user in the "x-admin" role —
  the object key `procurement/purchase_orders_report.hbs` IS the
  report identity, so the filename must exactly match the view name
  plus `.hbs`. This enables the "Print Report" button on the Purchase
  Orders report page. The report page compiles this template with
  Handlebars against `{ name, rows }`, where `rows` is the currently
  loaded report data, and opens the result in a new tab for printing
  or saving as a PDF.
-->
<h1>{{name}}</h1>
<table border="1" cellspacing="0" cellpadding="4">
  <thead>
    <tr>
      <th>Order</th>
      <th>Status</th>
      <th>Order Date</th>
      <th>Expected</th>
      <th>Supplier</th>
      <th>Supplier Email</th>
      <th>Department</th>
      <th>Lines</th>
      <th>Subtotal</th>
      <th>Tax</th>
      <th>Shipping</th>
      <th>Total</th>
      <th>Currency</th>
      <th>Delivery Address</th>
      <th>Supplier Ref</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr>
        <td>{{po_number}}</td>
        <td>{{status}}</td>
        <td>{{order_date}}</td>
        <td>{{expected_delivery_date}}</td>
        <td>{{supplier}}</td>
        <td>{{supplier_email}}</td>
        <td>{{department}}</td>
        <td>{{line_count}}</td>
        <td>{{subtotal}}</td>
        <td>{{tax_total}}</td>
        <td>{{shipping_total}}</td>
        <td>{{total}} {{currency}}</td>
        <td>{{currency}}</td>
        <td>{{delivery_address}}</td>
        <td>{{supplier_reference}}</td>
      </tr>
    {{else}}
      <tr>
        <td colspan="15">No data</td>
      </tr>
    {{/each}}
  </tbody>
</table>
