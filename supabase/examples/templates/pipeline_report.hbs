<!--
  Sample HTML-based PDF report template for crm.pipeline_report.

  Upload this file as-is to the `report-templates` storage bucket
  under the `crm` folder, as a user in the "x-admin" role — the
  object key `crm/pipeline_report.hbs` IS the report identity, so the
  filename must exactly match the view name plus `.hbs`. This enables
  the "Print Report" button on the Pipeline Report page. The report
  page compiles this template with Handlebars against
  `{ name, rows }`, where `rows` is the currently loaded report data,
  and opens the result in a new tab for printing or saving as a PDF.
-->
<h1>{{name}}</h1>
<table border="1" cellspacing="0" cellpadding="4">
  <thead>
    <tr>
      <th>Ref</th>
      <th>Opportunity</th>
      <th>Account</th>
      <th>Owner</th>
      <th>Stage</th>
      <th>Forecast</th>
      <th>Amount</th>
      <th>Prob.</th>
      <th>Weighted</th>
      <th>Close</th>
      <th>Age</th>
      <th>Next step</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr>
        <td>{{reference}}</td>
        <td>{{name}}</td>
        <td>{{account}}</td>
        <td>{{owner}}</td>
        <td>{{stage}}</td>
        <td>{{forecast_category}}</td>
        <td>{{amount}} {{currency}}</td>
        <td>{{probability}}%</td>
        <td>{{weighted_amount}}</td>
        <td>{{expected_close_on}}</td>
        <td>{{age_days}}d</td>
        <td>{{#if next_step}}{{next_step}}{{else}}—{{/if}}</td>
      </tr>
    {{else}}
      <tr>
        <td colspan="12">No data</td>
      </tr>
    {{/each}}
  </tbody>
</table>