<!--
  Sample HTML-based PDF report template for demo.invoices_report.

  Upload this file as-is to the `report-templates` storage bucket
  under the `demo` folder, as a user in the "x-admin" role — the
  object key `demo/invoices_report.hbs` IS the report identity, so
  the filename must exactly match the view name plus `.hbs`. This
  enables the "Print Report" button on the Invoices Report page. The
  report page compiles this template with Handlebars against
  `{ name, rows }`, where `rows` is the currently loaded report data,
  and opens the result in a new tab for printing or saving as a PDF.
-->
<h1>{{name}}</h1>
<table border="1" cellspacing="0" cellpadding="4">
  <thead>
    <tr>
      <th>Invoice #</th>
      <th>Status</th>
      <th>Client</th>
      <th>Project</th>
      <th>Issue Date</th>
      <th>Due Date</th>
      <th>Items</th>
      <th>Total</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr>
        <td>{{invoice_number}}</td>
        <td>{{status}}</td>
        <td>{{client}}</td>
        <td>{{project}}</td>
        <td>{{issue_date}}</td>
        <td>{{due_date}}</td>
        <td>{{item_count}}</td>
        <td>{{total}}</td>
      </tr>
    {{else}}
      <tr>
        <td colspan="8">No data</td>
      </tr>
    {{/each}}
  </tbody>
</table>